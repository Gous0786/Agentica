{
  "name": "agentica",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm registry:build && pnpm --filter www dev",
    "build": "pnpm registry:build && pnpm --filter www build",
    "registry:build": "node scripts/build-registry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p registry && tsc -p scripts && pnpm --filter www typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm registry:build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
